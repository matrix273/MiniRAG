# ===========================================
# PageIndex Web - Environment Variables Configuration Example
# ===========================================
# Copy this file to .env and fill in actual values
# cp .env.example .env

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kb

# ---------- JWT Authentication ----------
JWT_SECRET_KEY=your-jwt-secret-change-in-production

# ---------- MilvusLite Vector Database ----------
MILVUS_DB_PATH=./milvus_data.db

# ---------- gRPC Log Configuration ----------
# Suppress MilvusLite keepalive warning logs
GRPC_VERBOSITY=NONE
GRPC_CPP_VERBOSITY_LEVEL=none

# ---------- Application Configuration ----------
# Debug mode (set to False for production)
DEBUG=False

# File upload directory
UPLOAD_DIR=./uploads

# Maximum upload file size (bytes), default 50MB
MAX_UPLOAD_SIZE=52428800

# ---------- PageIndex Indexing Configuration ----------
# LLM model selection (supported: qwen/qwen-plus, gpt-4o-2024-11-20, anthropic/claude-sonnet-4-6)
MODEL=qwen/qwen-plus
# Retrieval model (default uses faster turbo model)
RETRIEVE_MODEL=qwen/qwen-turbo
# Maximum pages for TOC check (larger is more accurate but slower)
TOC_CHECK_PAGE_NUM=20
# Maximum pages per node
MAX_PAGE_NUM_EACH_NODE=10
# Maximum tokens per node
MAX_TOKEN_NUM_EACH_NODE=20000
# Whether to add node ID (yes/no)
IF_ADD_NODE_ID=yes
# Whether to add node summary (yes/no)
IF_ADD_NODE_SUMMARY=yes
# Whether to add document description (yes/no)
IF_ADD_DOC_DESCRIPTION=no
# Whether to add node text (yes/no)
IF_ADD_NODE_TEXT=no

# ---------- LLM Configuration ----------
# API Key can be set via environment variables (fallback when database not configured)
# DashScope API Key (for Qwen series models)
# DASHSCOPE_API_KEY=your-dashscope-api-key
# OpenAI API Key (for GPT models, optional)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Note: LLM configuration can also be set via frontend "System Configuration → LLM Configuration" page
# Database configuration takes priority over environment variables
# Including: model selection, API Key, vision feature toggle, etc.
# Related configuration items:
# DEFAULT_MODEL=qwen-plus
# VISION_ENABLED=false
# VISION_MODEL=qwen-vl-plus
