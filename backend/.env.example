# ===========================================
# PageIndex Web - 环境变量配置示例
# ===========================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ---------- 数据库 ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pageindex

# ---------- JWT 认证 ----------
JWT_SECRET_KEY=your-jwt-secret-change-in-production

# ---------- MilvusLite 向量数据库 ----------
MILVUS_DB_PATH=./milvus_data.db

# ---------- gRPC 日志配置 ----------
# 抑制 MilvusLite keepalive 告警日志
GRPC_VERBOSITY=NONE
GRPC_CPP_VERBOSITY_LEVEL=none

# ---------- 应用配置 ----------
# 调试模式（生产环境设为 False）
DEBUG=False

# 文件上传目录
UPLOAD_DIR=./uploads

# 最大上传文件大小（字节），默认 50MB
MAX_UPLOAD_SIZE=52428800

# ---------- PageIndex 索引配置 ----------
# LLM 模型选择 (支持: qwen/qwen-plus, gpt-4o-2024-11-20, anthropic/claude-sonnet-4-6)
MODEL=qwen/qwen-plus
# 检索模型 (默认使用更快的 turbo 模型)
RETRIEVE_MODEL=qwen/qwen-turbo
# TOC 检查的最大页数 (越大越准确，但越慢)
TOC_CHECK_PAGE_NUM=20
# 每个节点最大页数
MAX_PAGE_NUM_EACH_NODE=10
# 每个节点最大 token 数
MAX_TOKEN_NUM_EACH_NODE=20000
# 是否添加节点 ID (yes/no)
IF_ADD_NODE_ID=yes
# 是否添加节点摘要 (yes/no)
IF_ADD_NODE_SUMMARY=yes
# 是否添加文档描述 (yes/no)
IF_ADD_DOC_DESCRIPTION=no
# 是否添加节点文本 (yes/no)
IF_ADD_NODE_TEXT=no

# ---------- LLM 大模型配置 ----------
# API Key 可通过环境变量设置（数据库未配置时自动回退到此处）
# DashScope API Key (用于 Qwen 系列模型)
# DASHSCOPE_API_KEY=your-dashscope-api-key
# OpenAI API Key (用于 GPT 等模型，可选)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# 注意：LLM 配置也可通过前端「系统配置 → LLM 配置」页面设置
# 数据库配置优先级高于环境变量
# 包括：模型选择、API Key、视觉功能开关等
