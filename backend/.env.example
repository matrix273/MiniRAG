DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pageindex
OPENAI_API_KEY=your-openai-key
DASHSCOPE_API_KEY=your-dashscope-key
# JWT
JWT_SECRET_KEY=your-jwt-secret-change-in-production
# MilvusLite 向量数据库路径
MILVUS_DB_PATH=./milvus_data.db
# 抑制 MilvusLite gRPC keepalive 告警日志
GRPC_VERBOSITY=ERROR
GRPC_CPP_VERBOSITY_LEVEL=error
# 视觉模型
VISION_ENABLED=true
VISION_MODEL=dashscope/qwen3.6-plus
