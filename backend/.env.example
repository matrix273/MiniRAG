# ===========================================
# PageIndex Web - 环境变量配置示例
# ===========================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ---------- 数据库 ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pageindex

# ---------- JWT 认证 ----------
JWT_SECRET_KEY=your-jwt-secret-change-in-production

# ---------- MilvusLite 向量数据库 ----------
MILVUS_DB_PATH=./milvus_data.db

# ---------- gRPC 日志配置 ----------
# 抑制 MilvusLite keepalive 告警日志
GRPC_VERBOSITY=NONE
GRPC_CPP_VERBOSITY_LEVEL=none

# ---------- LLM 大模型配置 ----------
# 注意：LLM 配置已移至数据库管理，通过前端「系统配置 → LLM 配置」页面设置
# 包括：模型选择、API Key、视觉功能开关等
# 首次启动后请在前端配置以下项：
#   - llm_default_model (默认模型)
#   - llm_dashscope_key (DashScope API Key)
#   - llm_openai_key (OpenAI API Key，可选)
#   - llm_vision_enabled (视觉功能开关)
#   - llm_vision_model (视觉模型)
#   - llm_api_base_url (API 基础 URL)
